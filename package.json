{
  "name": "agent-team",
  "description": "Multi-agent orchestration panel",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "service",
    "webview"
  ],
  "scripts": {
    "build": "npm run build -w webview && npm run build -w service",
    "ccpa-proxy": "node dist/ccpa-proxy.js",
    "test:fast": "node scripts/run-tests.mjs root fast",
    "test": "node scripts/run-tests.mjs root unit",
    "test:browser": "node scripts/run-tests.mjs root browser",
    "test:e2e": "node scripts/run-tests.mjs root e2e",
    "bench:demo": "tsx scripts/bench-demo.ts",
    "bench:heavy": "tsx scripts/bench-heavy-transcript.ts",
    "test:slow": "node scripts/run-tests.mjs root slow",
    "test:ci": "node scripts/run-tests.mjs root ci",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "format": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run fmt:check",
    "capture": "tsx scripts/capture-sdk.ts",
    "summarize": "tsx scripts/summarize-capture.ts",
    "demo": "tsx scripts/seed-demo.ts",
    "import-issues": "tsx scripts/import-issues.ts",
    "vscode-icons": "tsx scripts/vscode-icons.ts",
    "sarasa-font": "tsx scripts/sarasa-font.ts",
    "smoke:codex": "tsx scripts/smoke-codex.ts"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.69.0"
  }
}
